# ==============================================================================
# BuildGhost // Triage Desk - Environment Configuration Template
# ==============================================================================

# Plane.so Issue Engine Integration
PLANE_API_URL=https://app.plane.so/api/v1
PLANE_API_KEY=your_plane_api_key_here
PLANE_WORKSPACE=buildghost
PLANE_PROJECT_ID=your_plane_project_uuid_here

# Resend Transactional Notification Dispatch
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=noreply@buildghost.site
ADMIN_EMAIL=buildghost.dev@gmail.com

# Safety Sandbox Mode (Strictly limits live outbound emails to ADMIN_EMAIL when true)
EMAIL_SAFE_MODE=true
